#!/bin/sh
set -eu

hook_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
repository_root=$(git -C "$hook_dir" rev-parse --show-toplevel 2>/dev/null) || {
	printf '%s\n' 'markdown-toc-pre-commit: cannot resolve the repository root' >&2
	exit 1
}
python=${PYTHON:-$repository_root/.venv/bin/python}
exec "$python" "$repository_root/scripts/markdown_pre_commit.py" "$@"
