{
  "swagger": "2.0",
  "operations": [
    {
      "path": "/payment/accounts",
      "method": "get",
      "operation_id": "PaymentService_ListAccounts",
      "produces": [
        "application/json"
      ],
      "responses": {
        "200": {
          "schema": {
            "type": "array",
            "items": {
              "type": "object",
              "$ref": "#/definitions/v1Account"
            }
          },
          "example": [
            {
              "policyAccountNumber": "payment-1",
              "policyNumber": "policy-1",
              "created": 1704067200000,
              "updated": 1704153600000
            }
          ]
        }
      }
    },
    {
      "path": "/payment/accounts/{accountNumber}",
      "method": "get",
      "operation_id": "PaymentService_GetAccountBalance",
      "produces": [
        "application/json"
      ],
      "parameters": [
        {
          "name": "accountNumber",
          "in": "path",
          "required": true,
          "type": "string"
        }
      ],
      "responses": {
        "200": {
          "schema": {
            "$ref": "#/definitions/v1AccountBalance"
          },
          "example": {
            "policyAccountNumber": "payment-1",
            "policyNumber": "policy-1",
            "balance": 12.34,
            "created": 1704067200000,
            "updated": 1704153600000
          }
        },
        "500": {
          "schema": {
            "$ref": "#/definitions/v1LegacyError"
          },
          "example": {
            "_links": {
              "self": {
                "href": "/payment/accounts/missing",
                "templated": false
              }
            },
            "message": "Internal Server Error"
          }
        }
      }
    }
  ],
  "request_contract": {
    "unknown_fields": "reject",
    "duplicate_fields": "reject",
    "non_empty_query": "reject",
    "accepted_response_types": [
      "application/json",
      "*/*"
    ]
  },
  "account_response_contract": {
    "list": "bare array",
    "timestamps": "numeric epoch milliseconds",
    "balance": "exact JSON number",
    "missing_status": 500,
    "missing_top_level_fields": [
      "_links",
      "message"
    ]
  },
  "schemas": {
    "v1Account": {
      "policyAccountNumber": {
        "type": "string"
      },
      "policyNumber": {
        "type": "string"
      },
      "created": {
        "type": "integer",
        "format": "int64"
      },
      "updated": {
        "type": "integer",
        "format": "int64"
      }
    },
    "v1AccountBalance": {
      "policyAccountNumber": {
        "type": "string"
      },
      "policyNumber": {
        "type": "string"
      },
      "balance": {
        "type": "number"
      },
      "created": {
        "type": "integer",
        "format": "int64"
      },
      "updated": {
        "type": "integer",
        "format": "int64"
      }
    },
    "v1LegacyError": {
      "_links": {
        "$ref": "#/definitions/v1ErrorLinks"
      },
      "message": {
        "type": "string"
      }
    },
    "v1ErrorLinks": {
      "self": {
        "$ref": "#/definitions/v1ErrorLink"
      }
    },
    "v1ErrorLink": {
      "href": {
        "type": "string"
      },
      "templated": {
        "type": "boolean"
      }
    }
  },
  "schema_required": {
    "v1LegacyError": [
      "message",
      "_links"
    ],
    "v1ErrorLinks": [
      "self"
    ],
    "v1ErrorLink": [
      "href",
      "templated"
    ]
  }
}
