{
  "swagger": "2.0",
  "info": {
    "title": "payment/v1/payment_service.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "PaymentService"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/payment/accounts": {
      "get": {
        "operationId": "PaymentService_ListAccounts",
        "responses": {
          "200": {
            "description": "Every Payment account as a bare JSON array.",
            "schema": {
              "type": "array",
              "items": {
                "type": "object",
                "$ref": "#/definitions/v1Account"
              }
            },
            "examples": {
              "application/json": [
                {
                  "policyAccountNumber": "payment-1",
                  "policyNumber": "policy-1",
                  "created": 1704067200000,
                  "updated": 1704153600000
                }
              ]
            }
          }
        },
        "tags": [
          "PaymentService"
        ],
        "produces": [
          "application/json"
        ]
      }
    },
    "/payment/accounts/{accountNumber}": {
      "get": {
        "operationId": "PaymentService_GetAccountBalance",
        "responses": {
          "200": {
            "description": "The Payment account and its current dated balance.",
            "schema": {
              "$ref": "#/definitions/v1AccountBalance"
            },
            "examples": {
              "application/json": {
                "policyAccountNumber": "payment-1",
                "policyNumber": "policy-1",
                "balance": 12.34,
                "created": 1704067200000,
                "updated": 1704153600000
              }
            }
          },
          "500": {
            "description": "The account is missing or the request failed unexpectedly.",
            "schema": {
              "$ref": "#/definitions/v1LegacyError"
            },
            "examples": {
              "application/json": {
                "_links": {
                  "self": {
                    "href": "/payment/accounts/missing",
                    "templated": false
                  }
                },
                "message": "Internal Server Error"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "accountNumber",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "PaymentService"
        ],
        "produces": [
          "application/json"
        ]
      }
    }
  },
  "definitions": {
    "v1Account": {
      "type": "object",
      "properties": {
        "policyAccountNumber": {
          "type": "string"
        },
        "policyNumber": {
          "type": "string"
        },
        "created": {
          "type": "integer",
          "format": "int64"
        },
        "updated": {
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "v1AccountBalance": {
      "type": "object",
      "properties": {
        "policyAccountNumber": {
          "type": "string"
        },
        "policyNumber": {
          "type": "string"
        },
        "balance": {
          "type": "number"
        },
        "created": {
          "type": "integer",
          "format": "int64"
        },
        "updated": {
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "v1ErrorLink": {
      "type": "object",
      "properties": {
        "href": {
          "type": "string"
        },
        "templated": {
          "type": "boolean"
        }
      },
      "required": [
        "href",
        "templated"
      ]
    },
    "v1ErrorLinks": {
      "type": "object",
      "properties": {
