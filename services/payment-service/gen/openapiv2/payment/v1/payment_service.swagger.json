    "v1GetAccountBalanceResponse": {
      "type": "object",
      "properties": {
        "account": {
          "$ref": "#/definitions/v1AccountBalance"
        }
      }
    },
    "v1LegacyError": {
      "type": "object",
      "properties": {
        "_links": {
          "$ref": "#/definitions/v1ErrorLinks"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "message",
        "_links"
      ]
    },
    "v1ListAccountsResponse": {
      "type": "object",
      "properties": {
        "accounts": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Account"
          }
        }
      }
    }
  }
