        "from": "2026-01-01",
        "to": "2026-12-31",
        "policyHolder": "Synthetic Holder A",
        "productCode": "HSI",
        "totalPremium": 123.45,
        "agentLogin": null
      }
    }
  },
  "cases": [
    {
      "id": "C05-E01",
