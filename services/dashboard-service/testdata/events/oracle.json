      "key": "SYN-KEY-IGNORED",
      "value": {
        "policy": {
          "number": "SYN-001",
          "from": [2026, 1, 1],
          "to": [2026, 12, 31],
          "policyHolder": "Synthetic Holder A",
          "productCode": "HSI",
          "totalPremium": 123.45,
          "agentLogin": null
