            "description": "The selected policies. Zero matches serialize as an empty object.",
            "schema": {
              "$ref": "#/definitions/v1SearchPoliciesResponse"
            },
            "examples": {
              "application/json": {
                "policies": [
                  {
                    "number": "POL-229",
                    "dateFrom": "2024-02-29",
                    "policyHolder": "Synthetic Holder"
                  }
                ]
              }
            }
          },
          "400": {
            "description": "The required q query value is absent or the query encoding is malformed.",
            "schema": {
              "$ref": "#/definitions/v1LegacyError"
            },
            "examples": {
              "application/json": {
                "message": "Required QueryValue [q] not specified",
                "path": "/queryText",
                "_links": {
                  "self": {
                    "href": "/policies",
                    "templated": false
                  }
                }
              }
            }
          },
          "404": {
            "description": "The requested route does not exist.",
            "schema": {
              "$ref": "#/definitions/v1LegacyError"
            },
            "examples": {
              "application/json": {
                "message": "Not Found",
                "_links": {
                  "self": {
                    "href": "/unknown",
                    "templated": false
                  }
                }
              }
            }
          },
          "405": {
            "description": "Only GET is allowed on /policies.",
            "schema": {
              "$ref": "#/definitions/v1LegacyError"
            },
            "examples": {
              "application/json": {
                "message": "Method Not Allowed",
                "_links": {
                  "self": {
                    "href": "/policies",
                    "templated": false
                  }
                }
              }
            },
            "headers": {
              "Allow": {
                "type": "string",
                "default": "GET"
              }
            }
          },
          "499": {
            "description": "The request was canceled.",
            "schema": {
              "$ref": "#/definitions/v1LegacyError"
            },
            "examples": {
              "application/json": {
                "message": "Request Canceled",
                "_links": {
                  "self": {
                    "href": "/policies",
                    "templated": false
                  }
                }
              }
            }
