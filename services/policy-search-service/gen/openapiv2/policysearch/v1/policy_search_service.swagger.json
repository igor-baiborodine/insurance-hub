                "message": "Internal Server Error",
                "_links": {
                  "self": {
                    "href": "/policies",
                    "templated": false
                  }
                }
              }
            }
          },
          "503": {
            "description": "The internal RPC service is unavailable.",
            "schema": {
              "$ref": "#/definitions/v1LegacyError"
            },
            "examples": {
              "application/json": {
                "message": "Service Unavailable",
                "_links": {
                  "self": {
                    "href": "/policies",
                    "templated": false
                  }
                }
              }
            }
          },
          "504": {
            "description": "The internal RPC deadline was exceeded.",
            "schema": {
              "$ref": "#/definitions/v1LegacyError"
            },
            "examples": {
              "application/json": {
                "message": "Gateway Timeout",
                "_links": {
                  "self": {
                    "href": "/policies",
                    "templated": false
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "q",
            "description": "Required at the HTTP boundary. Explicit empty and whitespace values remain valid.",
            "in": "query",
            "required": true,
            "type": "string"
          }
        ],
