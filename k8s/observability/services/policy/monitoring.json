{
  "acceptance": {
    "path": "acceptance.json"
  },
  "alerts": {
    "common_labels": {
      "service": "policy-service",
      "severity": "warning"
    },
    "expression_markers": {
      "PolicyDatabaseNotReady": [
        "insurance_hub_policy_dependency=\"database\"",
        "< 1"
      ],
      "PolicyEventPublicationFailure": [
        "insurance_hub_policy_event_publications_total",
        "insurance_hub_policy_event_outcome=\"error\"",
        "[5m]",
        "> 0"
      ],
      "PolicyHighLatency": [
        "histogram_quantile(0.95",
        "insurance_hub_service_transport=\"http\"",
        "> 0.5",
        ">= 20"
      ],
      "PolicyKafkaNotReady": [
        "insurance_hub_policy_dependency=\"kafka\"",
        "< 1"
      ],
      "PolicyResourcePressure": [
        "> 107374182.4",
        "> 0.16",
        "pod!~\"qa-policy-api-legacy-.*\""
      ],
      "PolicyServiceErrorRate": [
        "insurance_hub_service_transport=\"http\"",
        "> 0.05",
        ">= 20",
        "[5m]"
      ],
      "PolicyTelemetryBacklog": [
        "prometheus_remote_storage_samples_pending",
        "highest_sent_timestamp_seconds",
        "otelcol_exporter_queue_size",
        "> 0.8"
      ],
      "PolicyTelemetryDeliveryFailure": [
        "loki_write_dropped_entries_total",
        "prometheus_remote_storage_samples_failed_total",
        "prometheus_remote_storage_samples_dropped_total",
        "otelcol_exporter_send_failed_spans_total"
      ],
      "PolicyTelemetryMissing": [
        "absent_over_time",
        "go_goroutine_count",
        "[2m]"
      ],
      "PolicyUnavailable": [
        "kube_deployment_spec_replicas",
        "kube_deployment_status_replicas_available"
      ],
      "PolicyUnexpectedRestart": [
        "kube_pod_container_status_restarts_total",
        "[15m]"
      ],
      "PolicyUpstreamRPCFailure": [
        "rpc_client_call_duration_seconds_count",
        "sum by (rpc_method)",
        "pricing.v1.PricingService/CalculatePrice",
        "> 0.05",
        ">= 10"
      ]
    },
    "for": {
      "PolicyDatabaseNotReady": "2m",
      "PolicyEventPublicationFailure": null,
      "PolicyHighLatency": "5m",
      "PolicyKafkaNotReady": "2m",
      "PolicyResourcePressure": "5m",
      "PolicyServiceErrorRate": "2m",
      "PolicyTelemetryBacklog": "2m",
      "PolicyTelemetryDeliveryFailure": null,
      "PolicyTelemetryMissing": "1m",
      "PolicyUnavailable": "2m",
      "PolicyUnexpectedRestart": null,
      "PolicyUpstreamRPCFailure": "2m"
    },
    "group_name": "insurance-hub-policy-service",
    "interval": "30s",
    "inventory": {
      "common": [
        "PolicyServiceErrorRate",
        "PolicyHighLatency",
        "PolicyResourcePressure",
        "PolicyUnavailable",
        "PolicyTelemetryMissing",
        "PolicyTelemetryDeliveryFailure",
        "PolicyTelemetryBacklog",
        "PolicyUnexpectedRestart",
        "PolicyUpstreamRPCFailure"
      ],
      "dependencies": {
        "postgresql": [
          "PolicyDatabaseNotReady"
        ]
      },
      "workers": {
        "events": [
          "PolicyEventPublicationFailure",
          "PolicyKafkaNotReady"
        ]
      }
    },
    "path": "alerts.yaml",
    "prometheus_rule_name": "policy-service",
    "required_annotations": [
      "summary",
      "description",
      "runbook_action"
    ],
    "test_path": "alerts.test.yaml"
  },
  "capabilities": {
    "dependencies": [
      "postgresql"
    ],
    "workers": [
      "events"
    ]
  },
  "dashboard": {
    "application_selector": "service_name=\"policy-service\"",
    "editable": false,
    "minimum_prometheus_targets": 32,
    "outcomes": {
      "common": {
        "availability": [
          "Readiness and restarts"
        ],
        "investigation": [
          "Failed request and publication investigation logs",
          "Policy traces",
          "Investigation workflow"
        ],
        "pod_resources": [
          "Pod CPU and memory"
        ],
        "requests": [
          "Request rate",
          "Service error rate",
          "Request latency percentiles",
          "Upstream RPC outcomes",
          "Upstream RPC latency percentiles"
        ],
        "runtime": [
          "Go runtime"
        ],
        "telemetry_delivery": [
          "Telemetry delivery health"
        ]
      },
      "dependencies": {
        "postgresql": [
          "Database readiness"
        ]
      },
      "workers": {
        "events": [
          "Event publication outcomes",
          "Event publication latency percentiles",
          "Kafka publisher readiness"
        ]
      }
    },
    "path": "dashboard.json",
    "refresh": "30s",
    "required_markers": [
      "\"type\": \"loki\"",
      "\"type\": \"tempo\"",
      "trace_id",
      "Legitimate idle time",
      "missing telemetry",
      "collection failure",
      "shared Alloy pipeline",
      "insurance_hub_service_transport=\\\"http\\\"",
      "rpc_method=~\\\"product.v1.ProductService/GetProduct|pricing.v1.PricingService/CalculatePrice\\\"",
      "policy event publication deferred",
      "pod!~\\\"qa-policy-api-legacy-.*\\\""
    ],
    "required_query_filters": [
      "deployment_environment_name=~\"$environment\"",
      "service_implementation=~\"$implementation\""
    ],
    "uid": "insurance-hub-policy-service",
    "variables": {
      "environment": "deployment_environment_name",
      "implementation": "service_implementation"
    }
  },
  "fixture": {
    "minimum_scrapes_per_series": 4,
    "path": "fixture.json"
  },
  "schema_version": 2,
  "service": "policy",
  "service_name": "policy-service",
  "supported_environments": [
    "qa"
  ],
  "verification": {
    "expected_signals": {
      "logs": [
        "trace_id"
      ],
      "metrics": [
        "insurance_hub_service_requests_total",
        "insurance_hub_policy_dependency_ready",
        "insurance_hub_policy_event_publications_total"
      ],
      "traces": [
        "policy-service"
      ]
    },
    "probe": "policy"
  }
}
