{
  "alerts": {
    "expression_markers": {
      "ProductDatabasePoolPressure": [
        "db_client_connection_state=\"used\"",
        "> 0.8"
      ],
      "ProductDatabasePoolTimeouts": [
        "db_client_connection_timeouts_total",
        "[5m]"
      ],
      "ProductHighLatency": [
        "histogram_quantile(0.95",
        "> 0.5",
        ">= 20"
      ],
      "ProductResourcePressure": [
        "> 214748364.8",
        "> 0.24"
      ],
      "ProductServiceErrorRate": [
        "> 0.05",
        ">= 20",
        "[5m]"
      ],
      "ProductTelemetryBacklog": [
        "prometheus_remote_storage_samples_pending",
        "highest_sent_timestamp_seconds",
        "otelcol_exporter_queue_size",
        "> 0.8"
      ],
      "ProductTelemetryDeliveryFailure": [
        "loki_write_dropped_entries_total",
        "prometheus_remote_storage_samples_failed_total",
        "prometheus_remote_storage_samples_dropped_total",
        "otelcol_exporter_send_failed_spans_total"
      ],
      "ProductTelemetryMissing": [
        "absent_over_time",
        "go_goroutine_count",
        "[2m]"
      ],
      "ProductUnavailable": [
        "kube_deployment_spec_replicas",
        "kube_deployment_status_replicas_available"
      ],
      "ProductUnexpectedRestart": [
        "kube_pod_container_status_restarts_total",
        "[15m]"
      ]
    },
    "for": {
      "ProductDatabasePoolPressure": "5m",
      "ProductDatabasePoolTimeouts": null,
      "ProductHighLatency": "5m",
      "ProductResourcePressure": "5m",
      "ProductServiceErrorRate": "2m",
      "ProductTelemetryBacklog": "2m",
      "ProductTelemetryDeliveryFailure": null,
      "ProductTelemetryMissing": "1m",
      "ProductUnavailable": "2m",
      "ProductUnexpectedRestart": null
    },
    "group": "insurance-hub-product-service",
    "interval": "30s",
    "labels": {
      "service": "product-service",
      "severity": "warning"
    },
    "path": "alerts.yaml",
    "required_annotations": [
      "summary",
      "description",
      "runbook_action"
    ],
    "test_path": "alerts.test.yaml"
  },
  "dashboard": {
    "application_selector": "service_name=\"product-service\"",
    "editable": false,
    "minimum_prometheus_targets": 20,
    "path": "dashboard.json",
    "refresh": "30s",
    "required_markers": [
      "\"type\": \"loki\"",
      "\"type\": \"tempo\"",
      "trace_id",
      "Legitimate idle time",
      "missing telemetry",
      "pod!~\\\"qa-product-api-legacy-.*\\\""
    ],
    "required_panel_titles": [
      "Request rate",
      "Service error rate",
      "Request latency percentiles",
      "Database and pool latency",
      "Database pool pressure",
      "Go runtime",
      "Pod CPU and memory",
      "Readiness and restarts",
      "Telemetry delivery health",
      "Failed and slow-request investigation logs",
      "Product traces",
      "Investigation workflow"
    ],
    "required_query_filters": [
      "deployment_environment_name=~\"$environment\"",
      "service_implementation=~\"$implementation\""
    ],
    "uid": "insurance-hub-product-service",
    "variables": {
      "environment": "deployment_environment_name",
      "implementation": "service_implementation"
    }
  },
  "fixture": {
    "minimum_scrapes": 4,
    "path": "fixture.json"
  },
  "prometheus_rule_name": "product-service",
  "schema_version": 1,
  "service": "product",
  "service_name": "product-service",
  "supported_environments": [
    "qa"
  ]
}
