{
  "schemaVersion": 1,
  "services": {
    "product": {
      "repositoryRoot": "services",
      "modulePath": "services/product-service",
      "localImage": "insurance-hub-product-api",
      "registryImage": "ghcr.io/igor-baiborodine/insurance-hub/product-api",
      "kustomizeBase": "k8s/apps/svc/product/base",
      "overlays": {
        "local-dev": "k8s/overlays/local-dev/svc/product",
        "qa": "k8s/overlays/qa/svc/product"
      },
      "environments": [
        "local-dev",
        "qa"
      ],
      "capabilities": [
        "image-build",
        "image-check",
        "deploy-render",
        "deploy-check",
        "deploy-preflight",
        "deploy-status",
        "image-load",
        "deploy",
        "deploy-verify",
        "stop",
        "deploy-test-tooling",
        "deploy-test",
        "deploy-test-flux"
      ],
      "releaseTargets": [
        "qa"
      ],
      "administration": {
        "assets": {
          "migration": "services/product-service/internal/administration/migrations/00001_product.sql",
          "catalog": "services/product-service/internal/administration/seeds/base.json"
        },
        "maxMigrationSeconds": 180,
        "seedSeconds": 60,
        "minimumJobReserveSeconds": 60,
        "jobDeadlineSeconds": 300,
        "migrationContainer": "migrate"
      },
      "deploymentTargets": {
        "local-dev": {
          "mode": "direct",
          "context": "kind-local-dev-insurance-hub",
          "namespace": "local-dev-all",
          "dataNamespace": "local-dev-all",
          "overlay": "k8s/overlays/local-dev/svc/product",
          "initialization": {
            "overlay": "k8s/overlays/local-dev/svc/product/administration",
            "jobName": "local-dev-product-init",
            "migrationTimeout": "120s",
            "targetRevision": "1",
            "credentialRevision": "1",
            "attempt": 1,
            "waitSeconds": 420
          },
          "kindCluster": "local-dev-insurance-hub"
        },
        "qa": {
          "mode": "flux",
          "context": "qa-insurance-hub",
          "namespace": "qa-svc",
          "dataNamespace": "qa-data",
          "overlay": "k8s/overlays/qa/svc/product",
          "initialization": {
            "overlay": "k8s/overlays/qa/svc/product/administration",
            "jobName": "qa-product-init",
            "migrationTimeout": "120s",
            "targetRevision": "1",
            "credentialRevision": "1",
            "attempt": 1,
            "waitSeconds": 420
          },
          "flux": {
            "namespace": "flux-system",
            "sourcePrefix": "qa-product-release",
            "apiName": "qa-product-api",
            "bundle": "k8s/flux/qa/releases/product/release.yaml",
            "sharedSource": "insurance-hub",
            "sharedOwner": "qa-svc",
            "sharedPath": "./k8s/overlays/qa/svc",
            "branch": "main",
            "initializationTimeout": "6m",
            "apiTimeout": "5m"
          }
        }
      }
    },
    "policy-search": {
      "repositoryRoot": "services",
      "modulePath": "services/policy-search-service",
      "localImage": "insurance-hub-policy-search-api",
      "registryImage": "ghcr.io/igor-baiborodine/insurance-hub/policy-search-api",
      "kustomizeBase": "k8s/apps/svc/policy-search/base",
      "overlays": {
        "local-dev": "k8s/overlays/local-dev/svc/policy-search",
        "qa": "k8s/overlays/qa/svc/policy-search"
      },
      "environments": [
        "local-dev",
        "qa"
      ],
      "capabilities": [
        "image-build",
        "image-check",
        "deploy-render",
        "deploy-check",
        "deploy-preflight",
        "deploy-status",
        "image-load",
        "deploy",
        "deploy-verify",
        "stop",
        "fixture-setup",
        "fixture-verify",
        "fixture-retire",
        "event-fixture-setup",
        "event-fixture-verify",
        "event-fixture-retire",
        "cutover-index-inspect",
        "cutover-index-ensure",
        "cutover-index-verify",
        "canonical-secrets-migrate",
        "deploy-test-tooling",
        "deploy-test"
      ],
      "releaseTargets": [
        "qa"
      ],
      "administration": {
        "assets": {
          "fixture": "services/policy-search-service/internal/administration/fixture.json"
        },
        "index": "policy-views-issue-229",
        "role": "go_policy_search_reader",
        "user": "go_policy_search_reader",
        "events": {
          "owner": "issue-230",
          "index": "policy-views-issue-229",
          "writerRole": "go_policy_search_writer",
          "writerUser": "go_policy_search_writer",
          "registeredTopic": "policy-registered-issue-230",
          "terminatedTopic": "policy-terminated-issue-230",
          "consumerGroup": "policy-search-service-issue-230"
        },
        "cutover": {
          "owner": "issue-235",
          "index": "policy-views",
          "readerRole": "go_policy_search_cutover_reader",
          "readerUser": "go_policy_search_cutover_reader",
          "writerRole": "go_policy_search_cutover_writer",
          "writerUser": "go_policy_search_cutover_writer",
          "registeredTopic": "policy-registered",
          "terminatedTopic": "policy-terminated",
          "consumerGroup": "policy-search-service"
        }
      },
      "deploymentTargets": {
        "local-dev": {
          "mode": "direct",
          "context": "kind-local-dev-insurance-hub",
          "namespace": "local-dev-all",
          "dataNamespace": "local-dev-all",
          "overlay": "k8s/overlays/local-dev/svc/policy-search",
          "fixtureAdministration": {
            "service": "local-dev-elasticsearch-es-http",
            "adminSecret": "local-dev-elasticsearch-es-elastic-user",
            "workloadSecret": "local-dev-policy-search-qualification-elasticsearch",
            "eventWriterSecret": "local-dev-policy-search-qualification-elasticsearch-writer",
            "canonicalReaderSecret": "local-dev-policy-search-elasticsearch",
            "canonicalWriterSecret": "local-dev-policy-search-elasticsearch-writer",
            "canonicalElasticsearchCASecret": "",
            "canonicalKafkaCASecret": "local-dev-policy-search-kafka-ca",
            "kafkaCluster": "local-dev-kafka",
            "kafkaBootstrap": "local-dev-kafka-kafka-bootstrap:9093",
            "kafkaPublicCASecret": "local-dev-kafka-cluster-ca-cert",
            "kafkaWorkloadCASecret": "local-dev-policy-search-qualification-kafka-ca",
            "kafkaReplicas": 1
          },
          "kindCluster": "local-dev-insurance-hub"
        },
        "qa": {
          "mode": "flux",
          "context": "qa-insurance-hub",
          "namespace": "qa-svc",
          "dataNamespace": "qa-data",
          "overlay": "k8s/overlays/qa/svc/policy-search",
          "fixtureAdministration": {
            "service": "qa-elasticsearch-es-http",
            "adminSecret": "qa-elasticsearch-es-elastic-user",
            "workloadSecret": "qa-policy-search-qualification-elasticsearch",
            "publicCASecret": "qa-elasticsearch-es-http-certs-public",
            "workloadCASecret": "qa-policy-search-qualification-elasticsearch-ca",
            "serverName": "qa-elasticsearch-es-http.qa-data.svc",
            "eventWriterSecret": "qa-policy-search-qualification-elasticsearch-writer",
            "canonicalReaderSecret": "qa-policy-search-elasticsearch",
            "canonicalWriterSecret": "qa-policy-search-elasticsearch-writer",
            "canonicalElasticsearchCASecret": "qa-policy-search-elasticsearch-ca",
            "canonicalKafkaCASecret": "qa-policy-search-kafka-ca",
            "kafkaCluster": "qa-kafka",
            "kafkaBootstrap": "qa-kafka-kafka-bootstrap.qa-data.svc:9093",
            "kafkaPublicCASecret": "qa-kafka-cluster-ca-cert",
            "kafkaWorkloadCASecret": "qa-policy-search-qualification-kafka-ca",
            "kafkaReplicas": 3
          },
          "flux": {
            "namespace": "flux-system",
            "sourcePrefix": "qa-policy-search-release",
            "apiName": "qa-policy-search-api",
            "bundle": "k8s/flux/qa/releases/policy-search/release.yaml",
            "sharedSource": "insurance-hub",
            "sharedOwner": "qa-svc",
            "sharedPath": "./k8s/overlays/qa/svc",
            "branch": "main"
          }
        }
      }
    }
  }
}
