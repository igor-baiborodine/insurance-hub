{
  "schemaVersion": 1,
  "services": {
    "product": {
      "repositoryRoot": "services",
      "modulePath": "services/product-service",
      "localImage": "insurance-hub-product-api",
      "registryImage": "ghcr.io/igor-baiborodine/insurance-hub/product-api",
      "kustomizeBase": "k8s/apps/svc/product/base",
      "overlays": {
        "local-dev": "k8s/overlays/local-dev/svc/product",
        "qa": "k8s/overlays/qa/svc/product"
      },
      "environments": [
        "local-dev",
        "qa"
      ],
      "capabilities": [
        "image-build",
        "image-check",
        "deploy-render",
        "deploy-check",
        "deploy-preflight",
        "deploy-status",
        "image-load",
        "deploy",
        "deploy-verify",
        "stop",
        "deploy-test-tooling",
        "deploy-test",
        "deploy-test-flux"
      ],
      "releaseTargets": [
        "qa"
      ],
      "administration": {
        "assets": {
          "migration": "services/product-service/internal/administration/migrations/00001_product.sql",
          "catalog": "services/product-service/internal/administration/seeds/base.json"
        },
        "maxMigrationSeconds": 180,
        "seedSeconds": 60,
        "minimumJobReserveSeconds": 60,
        "jobDeadlineSeconds": 300,
        "migrationContainer": "migrate"
      },
      "deploymentTargets": {
        "local-dev": {
          "mode": "direct",
          "context": "kind-local-dev-insurance-hub",
          "namespace": "local-dev-all",
          "dataNamespace": "local-dev-all",
          "overlay": "k8s/overlays/local-dev/svc/product",
          "initialization": {
            "overlay": "k8s/overlays/local-dev/svc/product/administration",
            "jobName": "local-dev-product-init",
            "migrationTimeout": "120s",
            "targetRevision": "1",
            "credentialRevision": "1",
            "attempt": 1,
            "waitSeconds": 420
          },
          "kindCluster": "local-dev-insurance-hub"
        },
        "qa": {
          "mode": "flux",
          "context": "qa-insurance-hub",
          "namespace": "qa-svc",
          "dataNamespace": "qa-data",
          "overlay": "k8s/overlays/qa/svc/product",
          "initialization": {
            "overlay": "k8s/overlays/qa/svc/product/administration",
            "jobName": "qa-product-init",
            "migrationTimeout": "120s",
            "targetRevision": "1",
            "credentialRevision": "1",
            "attempt": 1,
            "waitSeconds": 420
          },
          "flux": {
            "namespace": "flux-system",
            "sourcePrefix": "qa-product-release",
            "apiName": "qa-product-api",
            "bundle": "k8s/flux/qa/releases/product/release.yaml",
            "sharedSource": "insurance-hub",
            "sharedOwner": "qa-svc",
            "sharedPath": "./k8s/overlays/qa/svc",
            "branch": "main",
            "initializationTimeout": "6m",
            "apiTimeout": "5m"
          }
        }
      }
    },
