      "required_dependency": "github.com/igor-baiborodine/insurance-hub/libs/servicekit",
      "workflows": [
        {
          "path": ".github/workflows/go-pr-mod.yml",
          "job": "validate"
        },
        {
          "path": ".github/workflows/go-pr-shared.yml",
