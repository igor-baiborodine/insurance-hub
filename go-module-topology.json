{
  "schemaVersion": 2,
  "repositoryModulePrefix": "github.com/igor-baiborodine/insurance-hub/",
  "modules": [
    {
      "directory": "templates/go-service",
      "modulePath": "github.com/igor-baiborodine/insurance-hub/templates/go-service",
      "role": "service-scaffold",
      "owner": "insurance-hub repository maintainers",
      "supportedModes": [
        "standalone"
      ],
      "validationTarget": "check-go-pr",
      "validationVariables": [
        "FORMAT_SCOPE",
        "FORMAT_BASE"
      ],
      "packageScope": "all Go packages under ./..., the server executable, owned Protobuf schema and generated output, and module dependency metadata",
      "prerequisites": [
        "Go 1.27.3",
        "pinned scaffold Go tools installed by make -C templates/go-service bootstrap-go-tools",
        "GCC for race-enabled tests",
        "public module, schema, tool, and vulnerability services unless cached"
      ],
      "consumers": [
        "github.com/igor-baiborodine/insurance-hub/templates/go-service"
      ],
      "localReplacements": [],
      "ciWorkflow": ".github/workflows/go-pr-mod.yml"
    },
    {
      "directory": "services/product-service",
      "modulePath": "github.com/igor-baiborodine/insurance-hub/services/product-service",
      "role": "business-service",
      "owner": "Product service maintainers",
      "supportedModes": [
        "standalone"
      ],
      "validationTarget": "check-go-pr",
      "validationVariables": [
        "FORMAT_SCOPE",
        "FORMAT_BASE"
      ],
      "packageScope": "all Product packages under ./..., the server executable, HTTP and gRPC adapters, generated Product v1 contract, sqlc-generated Product queries and PostgreSQL reader, fixture loader and disposable PostgreSQL suites, Protobuf/SQL source and generated output, and module dependency metadata",
      "prerequisites": [
        "Go 1.27.3",
        "pinned Product Go tools installed by make -C services/product-service bootstrap-go-tools",
        "GCC for race-enabled tests",
        "Docker Engine with daemon access for race-enabled integration tests",
        "pinned postgres:17.10-alpine image digest available locally or from its public registry",
        "public module and vulnerability services unless cached"
      ],
      "consumers": [
        "github.com/igor-baiborodine/insurance-hub/services/product-service"
      ],
      "localReplacements": [],
      "ciWorkflow": ".github/workflows/go-pr-mod.yml"
    },
    {
      "directory": "libs/servicekit",
      "modulePath": "github.com/igor-baiborodine/insurance-hub/libs/servicekit",
      "role": "public-shared",
      "owner": "insurance-hub repository maintainers",
      "supportedModes": [
        "standalone"
      ],
      "validationTarget": "check-go-pr",
      "validationVariables": [
        "FORMAT_SCOPE",
        "FORMAT_BASE"
      ],
      "packageScope": "config, identity, logger, telemetry and health public runtime packages; no server, business model, generated contract or persistence",
      "prerequisites": [
        "Go 1.27.3",
        "managed CPython 3.14.8",
        "pinned library tools via make -C libs/servicekit bootstrap-go-tools",
        "GCC for race tests",
        "public module and vulnerability services unless cached"
      ],
      "consumers": [
        "github.com/igor-baiborodine/insurance-hub/templates/go-service",
        "github.com/igor-baiborodine/insurance-hub/services/product-service"
      ],
      "localReplacements": [],
      "ciWorkflow": ".github/workflows/go-pr-shared.yml"
    }
  ],
  "workspaces": [],
  "exclusions": [
    {
      "pathPattern": ".git/**",
      "category": "repository-metadata",
      "reason": "Git implementation data is not repository topology."
    },
    {
      "pathPattern": "ai/artifacts/**",
      "category": "local-ticket-artifact",
      "reason": "Ignored ticket evidence is local working data."
    },
    {
      "pathPattern": "**/.tools/**",
      "category": "tool-cache",
      "reason": "Module-owned downloaded tools are disposable dependencies."
    },
    {
      "pathPattern": "**/vendor/**",
      "category": "dependency-tree",
      "reason": "Vendored dependency manifests do not define repository-owned modules."
    },
    {
      "pathPattern": "**/node_modules/**",
      "category": "dependency-tree",
      "reason": "JavaScript dependency manifests do not define repository-owned modules."
    },
    {
      "pathPattern": "**/third_party/**",
      "category": "dependency-tree",
      "reason": "Third-party source trees are not repository-owned modules."
    },
    {
      "pathPattern": "**/testdata/**",
      "category": "fixture",
      "reason": "Test fixtures are not supported repository topology."
    },
    {
      "pathPattern": "services/example-copy/**",
      "category": "generated-copy",
      "reason": "The scaffold reuse proof creates this disposable copy temporarily."
    }
  ],
  "activeConsumers": [
    {
      "module": "github.com/igor-baiborodine/insurance-hub/templates/go-service",
      "directory": "templates/go-service",
      "owner": "insurance-hub repository maintainers",
